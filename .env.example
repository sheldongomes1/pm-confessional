# PM Confessional — environment variables.
# Copy to `.env` for local dev. In production these live in Secret Manager /
# Cloud Run env (see deploy/DEPLOY.md). Never commit the real .env.

# ---- Database (Postgres 16 + pgvector) -----------------------------------
# Local dev: a normal connection string.
#   postgresql://USER:PASSWORD@HOST:5432/DBNAME
# Cloud Run + Cloud SQL (recommended, unix socket via the built-in connector):
#   postgresql://USER:PASSWORD@/DBNAME?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=
# Optional escape hatch checked before DATABASE_URL (used by some scripts).
# DATABASE_URL_OVERRIDE=

# ---- Anthropic (Decision Coach + regret extraction) ----------------------
# Off Replit you call Anthropic directly. Get a key at console.anthropic.com.
AI_INTEGRATIONS_ANTHROPIC_API_KEY=
# Was the Replit AI proxy; for direct calls use the real API base URL:
AI_INTEGRATIONS_ANTHROPIC_BASE_URL=https://api.anthropic.com

# ---- Gemini (embeddings: vector(768) + coach) ----------------------------
# Free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ---- PostHog (analytics) -------------------------------------------------
# Frontend (baked into the SPA at build time — see Dockerfile build args):
VITE_POSTHOG_KEY=phc_uJptRPCmQXZrB5tPBUzSLd4gxR5qySJtiC6eYuxyTAQF
VITE_POSTHOG_HOST=https://us.i.posthog.com
# Server-side (reads insights / project metadata). Project: PMConfessional (415646).
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=415646

# ---- Ingestion (Lenny's Data MCP) ----------------------------------------
# Only needed to ingest NEW episodes; serving the restored DB does not need it.
LENNYS_DATA_MCP_TOKEN=

# ---- Server runtime ------------------------------------------------------
# Cloud Run injects PORT (8080). BASE_PATH is the SPA base ("/" for one origin).
PORT=8080
BASE_PATH=/
NODE_ENV=production
LOG_LEVEL=info
# Set in the container so the API server serves the built SPA (single origin).
# Leave UNSET in local dev so Vite serves the frontend on its own port.
PUBLIC_DIR=/app/public

# ---- Coach confidence thresholds (optional; have code defaults) ----------
# HIGH_CONFIDENCE_THRESHOLD=
# LOW_CONFIDENCE_THRESHOLD=
